.gradle/
**/.gradle/
build/
**/build/
out/
**/out/
gradle-app.setting
.gradletasknamecache

# Keep the Gradle wrapper jar (it is intentionally committed)
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Prism / loader caches & generated sources
